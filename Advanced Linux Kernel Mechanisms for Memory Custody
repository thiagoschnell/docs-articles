    - libelf-dev

automation_steps:
  - name: "Prerequisites Ingestion"
    action: "apt-get update && apt-get install -y build-essential linux-headers-$(uname -r) cargo clang"
  
  - name: "Hardware Attestation Probe"
    action: "tpm2_getcap properties-fixed || echo 'Warning: Hardware TPM 2.0 validation fallback to software enclave'"

  - name: "Kernel Boot Parameter Stripping"
    action: |
      # Programmatically modifies GRUB to isolate the final 10GB block of physical RAM
      if ! grep -q "memmap=" /etc/default/grub; then
        sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="memmap=10G\$6G /' /etc/default/grub
        update-grub
        echo "Boot memory layout altered. System reboot required to enforce MemBlock Subsumption."
      fi

  - name: "Compile and Inject Modules"
    action: "cargo build --release && insmod ./target/release/libedge_vram.ko"
